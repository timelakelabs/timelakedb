# TimeLakeDB configuration — read by systemd as an EnvironmentFile.
#
# This file is a package config file: your edits survive an upgrade.
# Every setting here is a TIMELAKE_* environment variable; the full list and
# its defaults are in docs/ and site/docs/reference.html.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE EXPOSING THE PORTS
#
# The data plane is UNAUTHENTICATED by default (SECURITY.md exposure 1):
# with TIMELAKE_DATA_AUTH unset or `off`, ANY client that can reach port 1963
# or 1964 has full read and write access to every database, and can enumerate
# the schema. That is why this package binds LOOPBACK ONLY out of the box.
#
# Before changing TIMELAKE_ADDR/TIMELAKE_FLIGHT_ADDR to a routable address,
# do one of:
#   * set TIMELAKE_DATA_AUTH=required and issue tokens from the console
#     (/admin/ui) so every client presents one, or
#   * front the port with an authenticating proxy, or
#   * keep it on a private segment you trust as much as the data.
#
# `optional` is the migration state between the two: anonymous callers are
# still served, invalid tokens are refused, and the timelake_data_requests_*
# metrics show how much traffic would break at the flip.
# ---------------------------------------------------------------------------

# -- Listeners --------------------------------------------------------------
# HTTP (line protocol ingest, /api/sql, /admin/*).
TIMELAKE_ADDR=127.0.0.1:1963
# Flight SQL (gRPC).
TIMELAKE_FLIGHT_ADDR=127.0.0.1:1964

# -- Storage ----------------------------------------------------------------
# Owned by the timelake user; the only path the service may write.
TIMELAKE_DATA_DIR=/var/lib/timelake/data

# Object store. Unset = a local `objects/` directory under TIMELAKE_DATA_DIR.
# S3: TIMELAKE_OBJECT_STORE=s3://bucket/prefix (plus the stock AWS_* vars).
#TIMELAKE_OBJECT_STORE=

# -- Authentication (SEC-4) -------------------------------------------------
# off | optional | required. See the warning above; an unparseable value is
# refused at startup rather than silently downgraded.
TIMELAKE_DATA_AUTH=off

# Replaces the well-known first-run admin/admin credential when provisioning
# non-interactively. It does NOT clear the forced first-login rotation.
#TIMELAKE_ADMIN_BOOTSTRAP_PASSWORD=

# -- Encryption at rest (SEC-1/SEC-8) ---------------------------------------
# Covers every object written to the store AND the local WAL. Set exactly one
# of these two; setting both is refused at startup.
#TIMELAKE_ENCRYPTION_KEY_FILE=/etc/timelakedb/encryption.key
#TIMELAKE_KMS_KEY_ID=

# -- TLS (SEC-3) ------------------------------------------------------------
# Both must be set together, or startup fails. TIMELAKE_TLS_CLIENT_CA turns on
# want-mode client certificates.
#TIMELAKE_TLS_CERT=/etc/timelakedb/tls/server.crt
#TIMELAKE_TLS_KEY=/etc/timelakedb/tls/server.key
#TIMELAKE_TLS_CLIENT_CA=

# -- Audit trail (P1-2 / SR-6) ----------------------------------------------
# Admin mutations are recorded to a hash-chained log under TIMELAKE_DATA_DIR.
# Fail-closed by default: while the sink cannot append, mutations are refused
# with 503. Set to 1 only if you would rather keep mutating and be alerted.
#TIMELAKE_AUDIT_FAIL_OPEN=0

# -- Retention (FR-7) -------------------------------------------------------
# Seeds the policy on a fresh node: table=365d,other_table=72h. A policy set
# at runtime through /admin/retention is durable and outranks this.
#TIMELAKE_RETENTION=

# -- Resource guardrails (RR-1/RR-2) ----------------------------------------
#TIMELAKE_QUERY_MEM_BYTES=1073741824
#TIMELAKE_MAX_CONCURRENT_QUERIES=6
#TIMELAKE_MAX_CONCURRENT_QUERIES_PER_CLIENT=4
#TIMELAKE_QUERY_TIMEOUT_SECS=600

# -- Logging ----------------------------------------------------------------
RUST_LOG=info
