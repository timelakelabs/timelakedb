{
  "uid": "product-journey",
  "title": "Product Journey (lookup by product id)",
  "description": "Type a product id in the free-text field to see its pipeline status and the worker IP (172.16.<step>.n) each step ran on. Queries use fixed now()-relative 2-day windows. Status shows IN FLIGHT for dropped-out products too (they never reach step 10).",
  "tags": [
    "influxdb3-poc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "",
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "product_id",
        "label": "product id",
        "type": "textbox",
        "query": "p00000-00000",
        "current": {
          "text": "p00000-00000",
          "value": "p00000-00000"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "COMPLETED": {
                  "color": "green",
                  "index": 0
                },
                "IN FLIGHT": {
                  "color": "yellow",
                  "index": 1
                },
                "NOT FOUND": {
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT CASE WHEN COUNT(*) = 0 THEN 'NOT FOUND' WHEN MAX(CASE WHEN step = '10-upload' AND event = 'stop' THEN 1 ELSE 0 END) = 1 THEN 'COMPLETED' ELSE 'IN FLIGHT' END AS status FROM pipeline_events WHERE product_id = '$product_id' AND time >= now() - INTERVAL '2 days'",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last step reached",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT MAX(step) AS last_step FROM pipeline_events WHERE product_id = '$product_id' AND time >= now() - INTERVAL '2 days'",
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Steps completed",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT COUNT(*) AS steps_done FROM pipeline_events WHERE product_id = '$product_id' AND event = 'stop' AND time >= now() - INTERVAL '2 days'",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Route",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT MAX(route) AS route FROM pipeline_events WHERE product_id = '$product_id' AND time >= now() - INTERVAL '2 days'",
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total processing time",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT SUM(duration_s) AS processing_s FROM pipeline_events WHERE product_id = '$product_id' AND event = 'stop' AND time >= now() - INTERVAL '2 days'",
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Events",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT COUNT(*) AS events FROM pipeline_events WHERE product_id = '$product_id' AND time >= now() - INTERVAL '2 days'",
          "format": "table"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Journey by step - worker IP per step",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT step, worker_ip, MIN(time) AS started, MAX(time) AS finished, MAX(duration_s) AS duration_s FROM pipeline_events WHERE product_id = '$product_id' AND time >= now() - INTERVAL '2 days' GROUP BY step, worker_ip ORDER BY step",
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Raw events (time-ordered)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT time, step, event, worker_ip, route, duration_s FROM pipeline_events WHERE product_id = '$product_id' AND time >= now() - INTERVAL '2 days' ORDER BY time",
          "format": "table"
        }
      ]
    }
  ]
}
