{
  "uid": "pipeline-funnel",
  "title": "Product Pipeline Funnel",
  "description": "Products per step, in-flight vs processed. Queries use fixed now()-relative windows (see README).",
  "tags": [
    "influxdb3-poc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "Starts (24h)",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT date_bin(INTERVAL '15 minutes', time) AS time, COUNT(*) AS n FROM pipeline_events WHERE event = 'start' AND time >= now() - INTERVAL '24 hours' GROUP BY 1 ORDER BY 1",
          "format": "table"
        }
      ]
    },
